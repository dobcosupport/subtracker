# Copy to .env and fill in real values. NEVER commit .env to source control.
# The RPA key is sent as the x-subtracker-rpa-key header and is never logged.

# Base URL of the deployed SubTracker app (no trailing slash).
SUBTRACKER_BASE_URL=https://your-subtracker-host.example.com

# Shared secret the worker sends on every request (x-subtracker-rpa-key).
COMPLIANCE_SYNC_RPA_KEY=replace-with-real-rpa-key

# The NJ Public Works Power BI report URL.
NJ_PWC_REPORT_URL=https://app.powerbigov.us/view?r=REPLACE_WITH_REPORT_TOKEN

# Seconds to wait between polls when the queue is empty.
POLL_INTERVAL_SECONDS=30

# Worker log file path (directory is created automatically).
WORKER_LOG_PATH=./logs/nj-pwc-worker.log

# Run the browser headless. Use "false" for attended first-run validation,
# "true" for production after the flow is validated.
HEADLESS=false

# Daily NJ PWC registry sync: hour (0-23, America/New_York) at or after which
# the worker asks SubTracker to enqueue the day's run (once per day). Use
# "off" to disable. Scope, Mode, Test Mode, and expiration rules are server-side.
NJ_PWC_DAILY_SYNC_HOUR=6
