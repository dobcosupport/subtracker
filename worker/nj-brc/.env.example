# Copy this file to .env. Never commit .env or place production secrets here.
SUBTRACKER_BASE_URL=https://your-subtracker-host.example.com
NJ_BRC_WORKER_KEY=replace-with-nj-brc-worker-key

# Use a visible browser by default. Human verification must be completed manually.
HEADLESS=false
POLL_INTERVAL_SECONDS=30
NAVIGATION_TIMEOUT_MS=30000
HUMAN_VERIFICATION_TIMEOUT_MS=300000
MAX_PRE_SUBMISSION_RETRIES=2
WORKER_LOG_PATH=./logs/nj-brc-worker.log
NJ_BRC_CAPTURE_MODE=false
